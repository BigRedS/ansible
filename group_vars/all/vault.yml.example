---
# Copy this file to group_vars/all/vault.yml and fill in the real key:
#
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   $EDITOR group_vars/all/vault.yml
#
# group_vars/all/vault.yml is gitignored - it stays in cleartext and is
# never committed. If this repo ever gets pushed somewhere or shared,
# switch to `ansible-vault encrypt group_vars/all/vault.yml` instead and
# remove it from .gitignore.
otelcol_coralogix_private_key: "REPLACE_ME"
